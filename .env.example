# Copia este archivo como ".env" (sin ".example") y coloca tus valores reales.
# El archivo ".env" NUNCA debe subirse a un repositorio publico.

# API key de Groq para el chatbot (https://console.groq.com/keys)
GROQ_API_KEY=

# Token opcional para que el sensor Arduino/ESP32 publique lecturas de vibracion
SENSOR_INGEST_TOKEN=

# Client ID de OAuth de Google (Google Cloud Console > APIs y servicios >
# Credenciales > ID de cliente de OAuth > Aplicacion web). Sin esto, el boton
# "Continuar con Google" en login/registro se muestra pero avisa que no esta
# disponible en vez de fallar.
GOOGLE_CLIENT_ID=

# Envio de correo (verificacion de institucion) via SMTP de Gmail.
# 1) Activa la verificacion en 2 pasos en la cuenta de Gmail que enviara los correos.
# 2) Genera una "contrasena de aplicacion": https://myaccount.google.com/apppasswords
# 3) MAIL_USERNAME es la cuenta completa (ej. ndanatural68@gmail.com) y
#    MAIL_PASSWORD es la contrasena de aplicacion de 16 caracteres (no la de tu cuenta).
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=svNDA

# API key de OpenWeatherMap (https://openweathermap.org/api), para las capas
# de precipitacion/nubes/temperatura/viento del segundo mapa en Clima.
# Se expone en el HTML (data-owm-key), como GOOGLE_CLIENT_ID: no es secreta,
# solo sirve para pedir tiles de mapa, no para acceder a la cuenta.
OPENWEATHER_API_KEY=

# API key de CARTO Basemaps (https://carto.com/basemaps/apikey/), para los
# mapas de fondo (Zonas sismicas en Inicio, y el mapa 3D con terreno).
# Sin esto los tiles salen con el watermark "API KEY REQUIRED". Se expone
# en el HTML (window.__ndaCartoKey), no es secreta, solo pide tiles.
CARTO_API_KEY=
